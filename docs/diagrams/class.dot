digraph G { rankdir=TB; node [shape=record, fontname="Arial", style="filled", fillcolor="#EAF2FF", color="#2563EB"]; main [label="{Main|+ main()}"]; window [label="{ChatWindow|+ show()\n+ addBubble()}"]; controller [label="{ChatController|+ ask()\n+ newConversation()\n+ deleteConversation()}"]; service [label="{AIService|+ generateResponse()}"]; gemini [label="{GeminiService|+ generateResponse()\n- callModel()\n- fallback()}"]; repo [label="{ChatRepository|+ saveMessage()\n+ getMessages()\n+ deleteConversation()}"]; db [label="{DatabaseManager|+ connection()\n+ initialize()}"]; conv [label="{Conversation|id\ntitle\ncreatedAt}"]; msg [label="{Message|id\nconversationId\nrole\ncontent}"]; result [label="{AIResult|text\nmodel\ndemoMode\nfallback}"]; main->window; window->controller; controller->service; service->gemini; controller->repo; repo->db; repo->conv; repo->msg; service->result; }
